# Lista das variáveis do projeto. Gere o .env com: infra/generate-env.sh
POSTGRES_PASSWORD=
TICKETING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_SIMULATOR_SECRET=
# Par EC P-256 do passe da fila, em base64: privada PKCS#8 DER, pública X.509 DER.
QUEUE_PASS_PRIVATE_KEY=
QUEUE_PASS_PUBLIC_KEY=
# Configuração, não segredo: valores preenchidos aqui são copiados como estão.
# external exige HTTPS fora de rede privada. Use none só se o Docker desta
# máquina usar uma faixa que o Keycloak não reconhece como privada (100.64/10).
KEYCLOAK_SSL_REQUIRED=external
